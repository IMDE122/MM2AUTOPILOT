function AutoAttack:Execute(myRole, targetRoot)
    local char, hum, root = getCharacterParts(LocalPlayer)
    if not char or not root or not targetRoot then return end
    
    local weaponName = (myRole == "Murderer") and "Knife" or "Gun"
