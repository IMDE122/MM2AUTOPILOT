-- FULL ESP ENGINE MODULE
----------------------------------------------------------------
local ESPManager = { Highlights = {} }
function ESPManager:Update()
    for player, highlight in pairs(self.Highlights) do
        if not player.Parent or not State.EspEnabled then
            highlight:Destroy()
            self.Highlights[player] = nil
        end
    end

    if not State.EspEnabled then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local role = RoleResolver:Get(p)
            local highlight = self.Highlights[p]
            
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "ESP_Highlight"
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Parent = game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")
                self.Highlights[p] = highlight
            end
            
            highlight.Adornee = p.Character
            if role == "Murderer" then
                highlight.FillColor = Color3.fromRGB(231, 76, 60)
                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            elseif role == "Sheriff" then
                highlight.FillColor = Color3.fromRGB(52, 152, 219)
                highlight.OutlineColor = Color3.fromRGB(0, 0, 255)
            else
                highlight.FillColor = Color3.fromRGB(46, 204, 113)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end

