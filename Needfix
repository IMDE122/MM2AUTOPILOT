-- CONFIG & STATE Management
----------------------------------------------------------------
local CONFIG = {
    AgentRadius = 2,
    AgentHeight = 5,
    WaypointSpacing = 4,
    WaypointReachedDistance = 3,
    JumpCooldown = 0.8,
    StuckMovementThreshold = 0.5,
    StuckTimeThreshold = 1.5,
    RecoveryDistance = 6,
    MovementUpdateRate = 0.05,
    MemoryPruneRate = 10,
    AttackDistance = 35, 
}

local State = {
    Running = true,
    WalkSpeed = 16,
    JumpPower = 50,
    ChaseDistance = 100,
    AvoidDistance = 45,
    AvoidEnabled = true,
    AutoCollect = true,
    JumpAssist = true,
    StuckRecovery = true,
    AutoAttack = true,
    Priority = {
        AvoidMurderer = 100,
        AutoCollect = 40,
    }
}

local CharacterState = { Character = nil, Humanoid = nil, Root = nil }
local CharacterManager = {}

function CharacterManager:Refresh()
    local char, hum, root = getCharacterParts(LocalPlayer)
    CharacterState.Character = char
    CharacterState.Humanoid = hum
    CharacterState.Root = root
end

function CharacterManager:ApplyMovement()
    if CharacterState.Humanoid and isAlive(CharacterState.Humanoid) then
        CharacterState.Humanoid.WalkSpeed = State.WalkSpeed
        CharacterState.Humanoid.JumpPower = State.JumpPower
    end
end

----------------------------------------------------------------
-- ROLE RESOLVER
----------------------------------------------------------------
local RoleResolver = { Cache = {} }
function RoleResolver:Get(player)
    if not player then return "Unknown" end
    if self.Cache[player] then return self.Cache[player] end

    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")

    local function checkContainer(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local lname = string.lower(item.Name)
                if lname:find("knife") or lname:find("blade") or lname == "murderer" then return "Murderer"
                elseif lname:find("gun") or lname:find("revolver") or lname == "sheriff" then return "Sheriff" end
            end
        end
        return nil
    end

    local role = checkContainer(char) or checkContainer(backpack) or "Innocent"
    self.Cache[player] = role
    return role
end
function RoleResolver:Clear() table.clear(self.Cache) end

----------------------------------------------------------------
-- AUTO ATTACK MODULE
----------------------------------------------------------------
local AutoAttack = {}
function AutoAttack:Execute(myRole, targetRoot)
    local char = CharacterState.Character
    if not char then return end
    
    -- Find and equip weapon if needed
    local weaponName = (myRole == "Murderer") and "Knife" or "Gun"
    local tool = char:FindFirstChildOfClass("Tool")
    
    if not tool or not string.find(string.lower(tool.Name), string.lower(weaponName)) then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and string.find(string.lower(item.Name), string.lower(weaponName)) then
                    item.Parent = char
                    tool = item
                    break
                end
            end
        end
    end

    -- Trigger weapon activation targeting the entity
    if tool then
        char:SetPrimaryPartCFrame(CFrame.lookAt(CharacterState.Root.Position, Vector3.new(targetRoot.Position.X, CharacterState.Root.Position.Y, targetRoot.Position.Z)))
        tool:Activate()
        -- Fallback automated input trigger for legacy tools
        VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
    end
end

----------------------------------------------------------------
-- SCANNING & NAVIGATION
----------------------------------------------------------------
local CollectionManager = {}
function CollectionManager:GetNearest()
    local root = CharacterState.Root
    if not root then return nil, nil end
    local nearestItem, nearestPos = nil, nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "Item" or obj.Name == "CoinContainer") then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearestItem = obj
                nearestPos = obj.Position
            end
        end
    end
    return nearestItem, nearestPos
end

local ObstacleScanner = {}
function ObstacleScanner:Check(targetPosition)
    local root = CharacterState.Root
    if not root then return {Center = false, Low = false} end
    local direction = (targetPosition - root.Position)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { CharacterState.Character }

    local resultCenter = Workspace:Raycast(root.Position, direction, params)
    local resultLow = Workspace:Raycast(root.Position - Vector3.new(0, 1.5, 0), direction, params)
    return { Center = resultCenter ~= nil, Low = resultLow ~= nil }
end

local NavigationMemory = { Paths = {} }
function NavigationMemory:GetPath(startPos, destPos)
    for _, cached in ipairs(self.Paths) do
        if (cached.Start - startPos).Magnitude < 3 and (cached.Dest - destPos).Magnitude < 3 then return cached.Points end
    end
    return nil
end
function NavigationMemory:StorePath(startPos, destPos, waypoints)
    local pathPositions = {}
    for _, wp in ipairs(waypoints) do table.insert(pathPositions, wp.Position) end
    table.insert(self.Paths, { Start = startPos, Dest = destPos, Points = pathPositions, Time = os.clock() })
end
function NavigationMemory:Prune()
    local now = os.clock()
    for i = #self.Paths, 1, -1 do if now - self.Paths[i].Time > 5 then table.remove(self.Paths, i) end end
end

----------------------------------------------------------------
-- BEHAVIOR DECISION MATRIX
----------------------------------------------------------------
local BehaviorManager = {}
local pathInstance = PathfindingService:CreatePath({ AgentRadius = CONFIG.AgentRadius, AgentHeight = CONFIG.AgentHeight, WaypointSpacing = CONFIG.WaypointSpacing })
local currentWaypoints = {}
local currentWaypointIndex = 1
local lastPositionCheck = Vector3.new()
local lastPositionTime = os.clock()
local lastJumpTime = 0

function BehaviorManager:MoveTo(targetPos)
    local root = CharacterState.Root
    local hum = CharacterState.Humanoid
    if not root or not hum then return end

    if State.JumpAssist and os.clock() - lastJumpTime > CONFIG.JumpCooldown then
        local scan = ObstacleScanner:Check(targetPos)
        if scan.Low or scan.Center then hum.Jump = true; lastJumpTime = os.clock() end
    end

    if (targetPos - root.Position).Magnitude > 3 then
        local cachedPoints = NavigationMemory:GetPath(root.Position, targetPos)
        if cachedPoints then currentWaypoints = cachedPoints else
            local success, _ = pcall(function() pathInstance:ComputeAsync(root.Position, targetPos) end)
            if success and pathInstance.Status == Enum.PathStatus.Success then
                currentWaypoints = pathInstance:GetWaypoints()
                NavigationMemory:StorePath(root.Position, targetPos, currentWaypoints)
                currentWaypointIndex = 1
            else hum:MoveTo(targetPos); return end
        end

        if currentWaypoints and #currentWaypoints > 0 then
            if currentWaypointIndex > #currentWaypoints then currentWaypointIndex = #currentWaypoints end
            local nextWp = currentWaypoints[currentWaypointIndex]
            hum:MoveTo(nextWp.Position)
            if (root.Position - nextWp.Position).Magnitude < CONFIG.WaypointReachedDistance then currentWaypointIndex = currentWaypointIndex + 1 end
        end
    else hum:MoveTo(targetPos) end

    if State.StuckRecovery then
        if (root.Position - lastPositionCheck).Magnitude < CONFIG.StuckMovementThreshold then
            if os.clock() - lastPositionTime > CONFIG.StuckTimeThreshold then
                hum.Jump = true
                hum:MoveTo(root.Position + root.CFrame.RightVector * CONFIG.RecoveryDistance)
                lastPositionTime = os.clock()
            end
        else lastPositionCheck = root.Position; lastPositionTime = os.clock() end
    end
end

function BehaviorManager:Evaluate()
    CharacterManager:Refresh()
    local root = CharacterState.Root
    if not root then return end

    local highestPriority = -1
    local actionCallback = nil
    local myRole = RoleResolver:Get(LocalPlayer)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local _, hum, pRoot = getCharacterParts(player)
            if pRoot and hum and isAlive(hum) then
local dist = (pRoot.Position - root.Position).Magnitude
local role = RoleResolver\:Get(player)

\-- Combat Auto Attack Trigger
if State.AutoAttack and dist < CONFIG.AttackDistance then
if (myRole == "Murderer" and role \~= "Murderer") or (myRole == "Sheriff" and role == "Murderer") then
AutoAttack\:Execute(myRole, pRoot)
end
end

\-- Flee Threats
if State.AvoidEnabled and dist < State.AvoidDistance and role == "Murderer" and myRole \~= "Sheriff" then
local weight = State.Priority.AvoidMurderer
if weight > highestPriority then
highestPriority = weight
actionCallback = function()
local escapeDir = (root.Position - pRoot.Position).Unit
BehaviorManager\:MoveTo(root.Position + escapeDir \* CONFIG.RecoveryDistance)
end
end
end
end
end
end

\-- Coin Collection fallback
if State.AutoCollect and highestPriority < State.Priority.AutoCollect then
local \_, coinPos = CollectionManager\:GetNearest()
if coinPos then
highestPriority = State.Priority.AutoCollect
actionCallback = function() BehaviorManager\:MoveTo(coinPos) end
end
end

if actionCallback then actionCallback() end
end

