local CharacterManager = {}

function CharacterManager:Refresh()
    local char, hum, root = getCharacterParts(LocalPlayer)
    CharacterState.Character = char
    CharacterState.Humanoid = hum
    CharacterState.Root = root
end

function CharacterManager:ApplyMovement()
    if CharacterState.Humanoid and isAlive(CharacterState.Humanoid) then
        CharacterState.Humanoid.WalkSpeed = State.WalkSpeed
        CharacterState.Humanoid.JumpPower = State.JumpPower
    end
end

function CharacterManager:Restore()
    if CharacterState.Humanoid and isAlive(CharacterState.Humanoid) then
        CharacterState.Humanoid.WalkSpeed = CharacterState.OriginalSpeed
        CharacterState.Humanoid.JumpPower = CharacterState.OriginalJump
    end
end

----------------------------------------------------------------
-- ROLE RESOLVER
----------------------------------------------------------------

local RoleResolver = {
    Cache = {}
}

function RoleResolver:Get(player)
    if not player then return "Unknown" end
    if self.Cache[player] then return self.Cache[player] end

    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")

    local function checkContainer(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local lname = string.lower(item.Name)
                if lname:find("knife") or lname:find("blade") or lname == "murderer" then
                    return "Murderer"
                elseif lname:find("gun") or lname:find("revolver") or lname == "sheriff" then
                    return "Sheriff"
                elseif lname:find("hero") then
                    return "Hero"
                end
            end
        end
        return nil
    end

    local role = checkContainer(char) or checkContainer(backpack) or "Innocent"
    self.Cache[player] = role
    return role
end

function RoleResolver:Clear(player)
    if player then
        self.Cache[player] = nil
    else
        table.clear(self.Cache)
    end
end

----------------------------------------------------------------
-- SCANNING & NAVIGATION MEMORY MODULES
----------------------------------------------------------------

local CollectionManager = {}
function CollectionManager:GetNearest()
    local root = CharacterState.Root
    if not root then return nil, nil end

    local nearestItem, nearestPos = nil, nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "Item" or obj.Name == "CoinContainer") then
            local dist = (obj.Position - root.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearestItem = obj
                nearestPos = obj.Position
            end
        end
    end
    return nearestItem, nearestPos
end

local ObstacleScanner = {}
function ObstacleScanner:Check(targetPosition)
    local root = CharacterState.Root
    if not root then return nil end

    local origin = root.Position
    local direction = (targetPosition - origin)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { CharacterState.Character }

    local resultCenter = Workspace:Raycast(origin, direction, params)
    local resultLow = Workspace:Raycast(origin - Vector3.new(0, 1.5, 0), direction, params)

    return {
        Center = resultCenter ~= nil,
        Low = resultLow ~= nil
    }
end

local NavigationMemory = {
    Paths = {},
    Obstacles = {}
}
function NavigationMemory:GetPath(startPos, destPos)
    return nil
end
function NavigationMemory:StorePath(startPos, destPos, waypoints)
    local pathPositions = {}
    for _, wp in ipairs(waypoints) do
        table.insert(pathPositions, wp.Position)
    end
    table.insert(self.Paths, { Start = startPos, Dest = destPos, Points = pathPositions, Time = os.clock() })
end
function NavigationMemory:Prune()
    local now = os.clock()
    for i = #self.Paths, 1, -1 do
        if now - self.Paths[i].Time > 5 then
            table.remove(self.Paths, i)
        end
    end
end
function NavigationMemory:ClearPaths()
    table.clear(self.Paths)
end
function NavigationMemory:ClearObstacles()
    table.clear(self.Obstacles)
end

local MapScanner = {}
function MapScanner:Step() end
function MapScanner:Clear() end

----------------------------------------------------------------
-- BEHAVIOR MANAGER
----------------------------------------------------------------

local BehaviorManager = {}

local function makeCandidate(key, priority, destination, target, targetPos, description)
    return {
        Key = key,
        Priority = priority,
        Destination = destination,
        Target = target,
        TargetPosition = targetPos,
        Description = description,
    }
end

function BehaviorManager:GetCandidates()
    local candidates = {}
    local root = CharacterState.Root
    if not root then return candidates end

    local localPosition = root.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local _, pHand, pRoot = getCharacterParts(player)
            if pRoot and pHand and isAlive(pHand) then
                local distance = (pRoot.Position - localPosition).Magnitude

                ------------------------------------------------------------
                -- AVOID PLAYER
                ------------------------------------------------------------
                if State.AvoidEnabled and distance <= State.AvoidDistance then
                    local role = RoleResolver:Get(player)
                    local priorityKey = "Avoid" .. role
                    local priority = State.Priority[priorityKey]

                    if priority then
                        local away = (localPosition - pRoot.Position)
                        if away.Magnitude == 0 then
                            away = Vector3.new(
                                1,
                                0,
                                0
                            )
                        else
                            away = away.Unit
                        end

                        local avoidDestination = localPosition + (away * State.AvoidDistance)

                        local candidate = makeCandidate(
                            priorityKey,
                            priority,
                            avoidDestination,
                            player,
                            pRoot.Position,
                            "Avoid: " .. player.DisplayName .. " (" .. role .. ")"
                        )

                        if candidate then
                            table.insert(candidates, candidate)
                        end
                    end
                end

                ------------------------------------------------------------
                -- CHASE PLAYER
                ------------------------------------------------------------
                if State.ChaseEnabled and distance <= State.ChaseDistance then
                    local role = RoleResolver:Get(player)
                    local priorityKey = "Chase" .. role
                    local priority = State.Priority[priorityKey]

                    if priority then
                        local candidate = makeCandidate(
                            priorityKey,
                            priority,
                            pRoot.Position,
                            player,
                            pRoot.Position,
                            "Chase: " .. player.DisplayName .. " (" .. role .. ")"
                        )

                        if candidate then
                            table.insert(candidates, candidate)
                        end
                    end
                end
            end
        end
    end

    ------------------------------------------------------------
    -- AUTO COLLECT COINS / ITEMS
    ------------------------------------------------------------
    if State.AutoCollect then
        local item, itemPosition = CollectionManager:GetNearest()

        if item and itemPosition then
            local candidate = makeCandidate(
                "AutoCollect",
                State.Priority.AutoCollect,
                itemPosition,
                item,
                itemPosition,
                "Collect: " .. item.Name
            )

            if candidate then
                table.insert(candidates, candidate)
            end
        end
    end

    return candidates
end

function BehaviorManager:GetBest()
    local candidates = self:GetCandidates()

    if #candidates == 0 then
        return nil
    end

    table.sort(candidates, function(a, b)
        return a.Priority > b.Priority
    end)

    return candidates[1]
end

----------------------------------------------------------------
-- NAVIGATION CONTROLLER
----------------------------------------------------------------

local NavigationController = {
    CurrentPath = nil,
    Waypoints = {},
    CurrentWaypointIndex = 1,
    CurrentDestination = nil,
    CurrentTarget = nil,
    LastComputeTime = 0,
    LastPosition = Vector3.zero,
    StuckTimer = 0,
    LastJumpTime = 0,
    LastRecoveryTime = 0,
}

function NavigationController:ComputePath(startPos, destPos)
    local now = os.clock()

    if now - self.LastComputeTime < CONFIG.PathRecomputeCooldown then
        return false
    end

    self.LastComputeTime = now

    local cachedPositions = NavigationMemory:GetPath(startPos, destPos)
    if cachedPositions then
        self.Waypoints = {}
        for _, pos in ipairs(cachedPositions) do
            table.insert(self.Waypoints, { Position = pos })
        end
        self.CurrentWaypointIndex = 1
        self.CurrentDestination = destPos
        return true
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = CONFIG.AgentRadius,
        AgentHeight = CONFIG.AgentHeight,
        AgentCanJump = true,
        WaypointSpacing = CONFIG.WaypointSpacing,
    })

    local success = pcall(function()
        path:ComputeAsync(startPos, destPos)
    end)

    if success and path.Status == Enum.PathStatus.Success then
        self.CurrentPath = path
        self.Waypoints = path:GetWaypoints()
        self.CurrentWaypointIndex = 1
        self.CurrentDestination = destPos

        NavigationMemory:StorePath(startPos, destPos, self.Waypoints)
        return true
    end

    return false
end

function NavigationController:Update(dt)
    if not State.NavigationEnabled then
        State.CurrentBehavior = "Disabled"
        State.CurrentTargetName = "None"
        State.StatusText = "Navigation Inactive"
        return
    end

    local character = CharacterState.Character
    local humanoid = CharacterState.Humanoid
    local root = CharacterState.Root

    if not character or not humanoid or not root or not isAlive(humanoid) then
        State.CurrentBehavior = "Idle"
        State.CurrentTargetName = "None"
        State.StatusText = "Waiting for Character"
        return
    end

    local bestCandidate = BehaviorManager:GetBest()

    if not bestCandidate then
        State.CurrentBehavior = "Idle"
        State.CurrentTargetName = "None"
        State.StatusText = "Standing By"
        return
    end

    State.CurrentBehavior = bestCandidate.Key
    State.CurrentTargetName = bestCandidate.Target and (bestCandidate.Target.Name or tostring(bestCandidate.Target)) or "Target"
    State.StatusText = bestCandidate.Description

    local myPos = root.Position
    local destPos = bestCandidate.Destination

    local needsRepath = false
    if not self.CurrentDestination then
        needsRepath = true
    elseif (destPos - self.CurrentDestination).Magnitude > CONFIG.DestinationMoveThreshold then
        needsRepath = true
    elseif self.CurrentWaypointIndex > #self.Waypoints then
        needsRepath = true
    end

    if needsRepath then
        self:ComputePath(myPos, destPos)
    end

    if #self.Waypoints == 0 or self.CurrentWaypointIndex > #self.Waypoints then
        humanoid:MoveTo(destPos)
        return
    end

    local targetWaypoint = self.Waypoints[self.CurrentWaypointIndex]
    if not targetWaypoint then return end

    local distToWaypoint = (Vector3.new(targetWaypoint.Position.X, myPos.Y, targetWaypoint.Position.Z) - myPos).Magnitude

    if distToWaypoint <= CONFIG.WaypointReachedDistance then
        self.CurrentWaypointIndex += 1
        if self.CurrentWaypointIndex <= #self.Waypoints then
            targetWaypoint = self.Waypoints[self.CurrentWaypointIndex]
        end
    end

    if targetWaypoint then
        if State.ObstacleDetection then
            local obsCheck = ObstacleScanner:Check(targetWaypoint.Position)
            if obsCheck and (obsCheck.Center or obsCheck.Low) then
                local now = os.clock()
                if (State.JumpAssist and targetWaypoint.Action == Enum.PathWaypointAction.Jump) or obsCheck.Low then
                    if now - self.LastJumpTime >= CONFIG.JumpCooldown then
                        humanoid.Jump = true
                        self.LastJumpTime = now
                    end
                end
            end
        end

        local movedDist = (myPos - self.LastPosition).Magnitude
        if movedDist < CONFIG.StuckMovementThreshold then
            self.StuckTimer += dt
            if self.StuckTimer >= CONFIG.StuckTimeThreshold then
                if State.StuckRecovery then
                    local now = os.clock()
                    if now - self.LastRecoveryTime >= CONFIG.RecoveryCooldown then
                        humanoid.Jump = true
                        if State.SideRecovery then
                            local sideDir = root.CFrame.RightVector
                            humanoid:MoveTo(myPos + (sideDir * CONFIG.RecoveryDistance))
                        end
                        self.LastRecoveryTime = now
                        self:ComputePath(myPos, destPos)
                    end
                end
                self.StuckTimer = 0
            end
        else
            self.StuckTimer = 0
        end

        self.LastPosition = myPos
        humanoid:MoveTo(targetWaypoint.Position)
    end
end

