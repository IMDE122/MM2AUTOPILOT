function ESPController:Update()
    if not State.ESPEnabled then
        for _, folder in pairs(self.Containers) do
            folder.Parent = nil
        end
        return
    end

    local localRoot = CharacterState.Root

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character, humanoid, root = getCharacterParts(player)
            local container = self.Containers[player]

            if character and humanoid and root and localRoot then
                local distance = (root.Position - localRoot.Position).Magnitude

                if distance <= State.ESPMaxDistance then
                    if not container then
                        container = createESPFrame(player)
                        self.Containers[player] = container
                    end

                    container.Parent = workspace
                    local billboard = container:FindFirstChild("ESP_Billboard")
                    if billboard then
                        billboard.Adornee = character:FindFirstChild("Head") or root

                        local mainFrame = billboard:FindFirstChild("Frame")
                        if mainFrame then
                            local role = RoleResolver:Get(player)
                            local roleColor = ROLE_COLORS[role] or ROLE_COLORS.Unknown

                            local nameLabel = mainFrame:FindFirstChild("NameLabel")
                            if nameLabel then
                                nameLabel.Visible = State.ESPShowName or State.ESPShowUsername
                                local nameText = ""
                                if State.ESPShowName and State.ESPShowUsername then
                                    nameText = player.DisplayName .. " (@" .. player.Name .. ")"
                                elseif State.ESPShowName then
                                    nameText = player.DisplayName
                                else
                                    nameText = "@" .. player.Name
                                end

                                if State.ESPShowSelected and State.SelectedPlayer == player then
                                    nameText = "[TARGET] " .. nameText
                                end
                                nameLabel.Text = nameText
                            end

                            local roleLabel = mainFrame:FindFirstChild("RoleLabel")
                            if roleLabel then
                                roleLabel.Visible = State.ESPShowRole
                                roleLabel.Text = "[" .. role .. "]"
                                roleLabel.TextColor3 = roleColor
                            end

                            local distLabel = mainFrame:FindFirstChild("DistLabel")
                            if distLabel then
                                distLabel.Visible = State.ESPShowDistance
                                distLabel.Text = string.format("%d studs", math.floor(distance))
                            end

                            local healthBg = mainFrame:FindFirstChild("HealthBg")
                            if healthBg then
                                healthBg.Visible = State.ESPShowHealth
                                local healthFill = healthBg:FindFirstChild("HealthFill")
                                if healthFill and humanoid.MaxHealth > 0 then
                                    local pct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                                    healthFill.Size = UDim2.new(pct, 0, 1, 0)
                                    healthFill.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 50)
                                end
                            end
                        end
                    end
                else
                    if container then
                        container.Parent = nil
                    end
                end
            else
                if container then
                    container.Parent = nil
                end
            end
        end
    end
end

function ESPController:Remove(player)
    if self.Containers[player] then
        self.Containers[player]:Destroy()
        self.Containers[player] = nil
    end
end

function ESPController:ClearAll()
    for _, folder in pairs(self.Containers) do
        folder:Destroy()
    end
    table.clear(self.Containers)
end

connect(Players.PlayerRemoving, function(player)
    RoleResolver:Clear(player)
    ESPController:Remove(player)
end)

