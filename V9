function UIController:RefreshPlayerList()
    local plrFrame = self.TabFrames["Players"]
    if not plrFrame then return end

    for _, child in ipairs(plrFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local item = Instance.new("Frame")
            item.Size = UDim2.new(1, 0, 0, 30)
            item.BackgroundColor3 = Color3.fromRGB(32, 36, 44)
            item.Parent = plrFrame

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 4)
            corner.Parent = item

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -85, 1, 0)
            nameLbl.Position = UDim2.new(0, 8, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = player.DisplayName .. " (@" .. player.Name .. ")"
            nameLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
            nameLbl.Font = Enum.Font.SourceSans
            nameLbl.TextSize = 12
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = item

            local selectBtn = Instance.new("TextButton")
            selectBtn.Size = UDim2.new(0, 65, 0, 20)
            selectBtn.Position = UDim2.new(1, -71, 0.5, -10)
            selectBtn.BackgroundColor3 = (State.SelectedPlayer == player) and Color3.fromRGB(220, 120, 40) or Color3.fromRGB(50, 100, 180)
            selectBtn.Text = (State.SelectedPlayer == player) and "Selected" or "Select"
            selectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            selectBtn.Font = Enum.Font.SourceSansBold
            selectBtn.TextSize = 11
            selectBtn.Parent = item

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = selectBtn

            selectBtn.MouseButton1Click:Connect(function()
                if State.SelectedPlayer == player then
                    State.SelectedPlayer = nil
                else
                    State.SelectedPlayer = player
                end
                self:RefreshPlayerList()
            end)
        end
    end
end

function UIController:UpdateStatus()
    if self.StatusLabels.Status then
        self.StatusLabels.Status.Text = string.format(
            "Behavior: %s | Target: %s | %s",
            State.CurrentBehavior,
            State.CurrentTargetName,
            State.StatusText
        )
    end
end

----------------------------------------------------------------
-- MAIN ENGINE LAUNCH & LIFECYCLE
----------------------------------------------------------------

local IMDEHub = {}

function IMDEHub:Start()
    CharacterManager:Refresh()
    UIController:BuildUI()

    local lastMoveUpdate = 0
    local lastESPUpdate = 0
    local lastUIUpdate = 0
    local lastPruneUpdate = 0

    connect(RunService.Heartbeat, function(dt)
        if not State.Running then return end

        local now = os.clock()

        CharacterManager:Refresh()
        CharacterManager:ApplyMovement()

        if now - lastMoveUpdate >= CONFIG.MovementUpdateRate then
            NavigationController:Update(dt)
            MapScanner:Step()
            lastMoveUpdate = now
        end

        if now - lastESPUpdate >= CONFIG.ESPUpdateRate then
            ESPController:Update()
            lastESPUpdate = now
        end

        if now - lastUIUpdate >= CONFIG.UIUpdateRate then
            UIController:UpdateStatus()
            lastUIUpdate = now
        end

        if now - lastPruneUpdate >= CONFIG.MemoryPruneRate then
            NavigationMemory:Prune()
            lastPruneUpdate = now
        end
    end)

    connect(Players.PlayerAdded, function()
        task.wait(0.5)
        UIController:RefreshPlayerList()
    end)

    connect(Players.PlayerRemoving, function(player)
        if State.SelectedPlayer == player then
            State.SelectedPlayer = nil
        end
        UIController:RefreshPlayerList()
    end)
end

function IMDEHub:Destroy()
    State.Running = false
    disconnectAll()
    ESPController:ClearAll()
    CharacterManager:Restore()
    MapScanner:Clear()
    NavigationMemory:ClearPaths()
    NavigationMemory:ClearObstacles()

    if UIController.Gui then
        UIController.Gui:Destroy()
        UIController.Gui = nil
    end
end

-- Launch Hub
IMDEHub:Start()
